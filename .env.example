# Скопируй этот файл в .env и впиши свои значения. Файл .env в git не попадает.

# Ключ авторизации из личного кабинета GigaChat API (developers.sber.ru)
GIGACHAT_CREDENTIALS=

# Для физлиц
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модели: быстрая для выжимок каждого материала, сильная для итоговой сводки
GIGACHAT_MODEL_FAST=GigaChat-2
GIGACHAT_MODEL_STRONG=GigaChat-2-Pro

# Если видишь ошибку сертификата: лучше указать путь к корневому сертификату Минцифры,
# для быстрой проверки можно поставить false (для постоянной работы так не оставляй)
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE=
